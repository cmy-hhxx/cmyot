# handoff.env — 本仓库的验收门命令（每个仓库填一次）
#
# 用法：
#   source docs/handoff/_protocol/handoff.env
#   TRACK=ui   TASK_DIR=docs/handoff/<slug> bash docs/handoff/_protocol/scripts/gate.sh G1
#   TRACK=arch TASK_DIR=docs/handoff/<slug> BASE_TAG=baseline/<slug> bash docs/handoff/_protocol/scripts/gate.sh G2
#
# 注意：
# - 这是项目配置，可以提交；不要往这里写密钥。
# - monorepo 记得指定包，例如 "pnpm -F @app/web typecheck"。
# - 命令必须是当前目录下能直接跑的；跑不通就先修仓库（这一步就是 G0）。

# ---- UI 轨道 ----
export TYPECHECK_CMD="pnpm -s typecheck"
export BUILD_CMD="pnpm -s build"
# 截图门：STILLS_URL 设置后，gate 会跑 3 视口截图 + console error 检查（需要 playwright）
export DEV_URL="http://localhost:5173"
export STILLS_URL="$DEV_URL"
# 令牌文件/目录的识别正则（用于裸值检查）
export TOKEN_HINTS="tokens|theme|tailwind"

# ---- ARCH 轨道 ----
# 测试是重构的唯一安全网，ARCH 轨道必填
# export TEST_CMD="pnpm -s test --run"
# 依赖方向 / 无环 / 边界规则检查（dependency-cruiser、madge、eslint boundaries、import-linter 或自写脚本）
export ARCH_CHECK_CMD=""
# 公共 API 兼容性检查（api-extractor、knip、tsc 生成 .d.ts diff 等，可选）
export API_CHECK_CMD=""
