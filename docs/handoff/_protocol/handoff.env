# handoff.env — cmyot（CotEditor，macOS 原生 Swift/AppKit）
#
# 用法：
#   source docs/handoff/_protocol/handoff.env
#   TASK_DIR=docs/handoff/<slug> bash docs/handoff/_protocol/scripts/gate.sh G1
#
# 注意：
# - 这是项目配置，可以提交；不要往这里写密钥。
# - 原生 macOS app：截图门（STILLS_URL / playwright）不适用，视觉验收改为人工截图，
#   见 docs/handoff/<slug>/BRIEF.md 的「验证方式」一节。

# ---- UI 轨道 ----
# Swift 没有独立的 typecheck 步骤；BUILD_CMD 已覆盖编译检查
export TYPECHECK_CMD=""
export BUILD_CMD="xcodebuild -project CotEditor.xcodeproj -scheme CotEditor -configuration Debug -derivedDataPath /tmp/cmyot-dd build -quiet"

# 原生 app 不用浏览器截图；留空 = gate 跳过截图门并给出警告（预期行为）
export STILLS_URL=""

# 令牌 / 主题文件的识别正则（裸色值检查用）
export TOKEN_HINTS="Theme|Color|Appearance|Style|tokens"

# ---- ARCH 轨道（以后做架构任务时再启用）----
# export TEST_CMD="xcodebuild -project CotEditor.xcodeproj -scheme CotEditor -destination 'platform=macOS' -derivedDataPath /tmp/cmyot-dd test -quiet"
# export ARCH_CHECK_CMD=""
# export API_CHECK_CMD=""
